# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# PostgreSQL. Production runs on Hetzner Kubernetes (CloudNativePG) and is
# reached through a Cloudflare Access TCP tunnel that must be running first:
#
#   cloudflared access tcp --hostname sql.myrealprofit.io --url localhost:15432
#
# That is a foreground process and needs a one-time Cloudflare Access browser
# login as filip@myrealprofit.com; the token is cached afterwards.
#
# ONLY code running on your own machine can use this tunnel. Anything deployed
# elsewhere — Cloud Run, a Worker, a cron inside the cluster, CI — cannot reach
# it and needs a Cloudflare Access service token or to run inside the cluster.
#
# The defaults below are already correct, so you normally set none of them.
# 127.0.0.1, never "localhost": the tunnel is IPv4-only and ::1 fails with a
# misleading "connection refused".
#PGHOST=127.0.0.1
#PGPORT=15432
#PGUSER=ro_filip_seidel
#PGDATABASE=main

# NO PASSWORD HERE. libpq reads it from ~/.pgpass.

# Optional: a full connection string overrides every PG* value above.
#DATABASE_URL=postgresql://user@host:5432/dbname

# Prod API host (no trailing slash)
PROD_HOST=https://your-prod-host.com

# Credentials for /login endpoint
API_USERNAME=filip@myrealprofit.com
API_PASSWORD=your_password_here

# Slack bot token  (starts with xoxb-)
SLACK_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Slack channel to watch (default is #internal-shared-account)
SLACK_CHANNEL=#internal-shared-account
