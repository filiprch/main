# Copy to .env and fill in values
DB_HOST=136.112.125.16
DB_NAME=postgres
DB_USER=filip_read_only
DB_PASSWORD=your_db_password

# Amazon LWA (Login with Amazon) — from Postman Globals
LWA_CLIENT_ID=amzn1.application-oa2-client.your_client_id
LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.your_client_secret

# AWS credentials for SP API signing (Step 3)
# Use STS temp keys if you have them, otherwise app IAM keys
AWS_ACCESS_KEY_ID=AKIAQ3TFFEITQENCOF3L
AWS_SECRET_ACCESS_KEY=your_app_secret_key
AWS_SESSION_TOKEN=optional_sts_session_token
AWS_REGION=us-east-1

# ── Reports PUT (Batch) card ──────────────────────────────────────────────
# Powers the "Batch Reports PUT" card (PUT /reports/bi/<seller_id>/reports).
# It authenticates with PROD_HOST + API_USERNAME/API_PASSWORD via /login,
# OR set ACCESS_TOKEN to skip login and reuse a token you already have.
PROD_HOST=https://api.myrealprofit.com
API_USERNAME=filip@myrealprofit.com
API_PASSWORD=your_password
# ACCESS_TOKEN=eyJhbGci...

# ── Shared account bot (bot.py) ───────────────────────────────────────────
SLACK_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#internal-shared-account
