# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# PostgreSQL connection string (read-only user recommended — see DB SETUP below)
DATABASE_URL=postgresql://bot_readonly:your_password@your_host:5432/your_database

# Prod API host (no trailing slash)
PROD_HOST=https://your-prod-host.com

# Credentials for /login endpoint
API_USERNAME=filip@myrealprofit.com
API_PASSWORD=your_password_here

# Slack bot token  (starts with xoxb-)
SLACK_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Slack channel to watch (default is #internal-shared-account)
SLACK_CHANNEL=#internal-shared-account
